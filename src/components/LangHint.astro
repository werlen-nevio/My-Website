---
import Icon from './ui/Icon.astro';
import { useT, localizePath, type Lang } from '../i18n';

/**
 * Suggests the other language when the browser prefers it.
 * Hidden until scripts/lang.ts decides to show it; written in the
 * target language so the visitor can actually read it.
 */
interface Props {
    lang: Lang;
    path: string;
}

const { lang, path } = Astro.props;
const t = useT(lang);
const target: Lang = lang === 'de' ? 'en' : 'de';
---

<div class="lang-hint theme-dark glass" role="region" aria-label={t('lang.hint')} lang={target} data-lang-hint={target} hidden>
    <p class="lang-hint__text">{t('lang.hint')}</p>
    <a class="lang-hint__action" href={localizePath(path, target)} hreflang={target} data-lang-link={target}>
        {t('lang.hintAction')}
        <Icon name="arrow-right" size={15} />
    </a>
    <button class="lang-hint__close" type="button" data-lang-hint-dismiss>
        <Icon name="close" size={16} />
        <span class="sr-only">{t('lang.hintDismiss')}</span>
    </button>
</div>

<style>
    .lang-hint {
        position: fixed;
        left: 50%;
        bottom: calc(var(--s-4) + env(safe-area-inset-bottom));
        z-index: var(--z-toast);
        display: flex;
        align-items: center;
        gap: var(--s-3);
        width: max-content;
        max-width: calc(100vw - var(--gutter) * 2);
        padding: 0.5rem 0.5rem 0.5rem 1.125rem;
        border-radius: var(--r-full);
        font-size: var(--fs-sm);
        color: var(--text-2);
        transform: translate(-50%, 0);
        transition:
            transform 0.6s var(--ease-out),
            opacity 0.4s var(--ease-soft);
    }

    .lang-hint[hidden] {
        display: none;
    }

    .lang-hint.is-entering {
        transform: translate(-50%, 140%);
        opacity: 0;
    }

    .lang-hint__action {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        height: 2.25rem;
        padding-inline: 0.875rem;
        border-radius: var(--r-full);
        background: var(--text);
        color: var(--ink-900);
        font-weight: 600;
        white-space: nowrap;
    }

    .lang-hint__close {
        display: inline-grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: var(--r-full);
        color: var(--text-3);
        transition: color var(--dur-2) var(--ease-soft);
    }

    .lang-hint__close:hover {
        color: var(--text);
    }

    @media (max-width: 559px) {
        .lang-hint {
            flex-wrap: wrap;
            border-radius: var(--r-lg);
            padding: var(--s-4);
        }

        .lang-hint__text {
            flex: 1 1 100%;
            padding-right: var(--s-7);
        }

        .lang-hint__close {
            position: absolute;
            top: var(--s-2);
            right: var(--s-2);
        }
    }
</style>
