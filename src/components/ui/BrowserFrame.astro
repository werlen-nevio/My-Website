---
/**
 * A quiet browser window. The slot holds the fallback (a designed mock);
 * when `src` is set, the screenshot is layered on top and the mock is
 * only shown if the image fails to load (see scripts/core/media.ts).
 */
interface Props {
    domain: string;
    src?: string;
    alt?: string;
    eager?: boolean;
    class?: string;
}

const { domain, src, alt = '', eager = false, class: className } = Astro.props;
---

<div class:list={['frame', className]}>
    <div class="frame__bar" aria-hidden="true">
        <span class="frame__dots"><i></i><i></i><i></i></span>
        <span class="frame__url">{domain}</span>
    </div>
    <div class="frame__view">
        <div class="frame__mock" aria-hidden={src ? 'true' : undefined}>
            <slot />
        </div>
        {
            src && (
                <img
                    class="frame__shot"
                    src={src}
                    alt={alt}
                    loading={eager ? 'eager' : 'lazy'}
                    decoding="async"
                    width="1600"
                    height="1000"
                    data-fallback
                />
            )
        }
    </div>
</div>

<style>
    .frame {
        --frame-r: var(--r-lg);
        position: relative;
        display: flex;
        flex-direction: column;
        border-radius: var(--frame-r);
        background: color-mix(in srgb, var(--surface-solid) 92%, transparent);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-2);
        overflow: hidden;
        isolation: isolate;
    }

    .frame__bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 2.25rem;
        padding-inline: 0.875rem;
        border-bottom: 1px solid var(--line);
        flex: none;
    }

    .frame__dots {
        position: absolute;
        left: 0.875rem;
        display: flex;
        gap: 6px;
    }

    .frame__dots i {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--line-strong);
    }

    .frame__url {
        padding: 0.15rem 0.75rem;
        border-radius: var(--r-xs);
        background: var(--surface-2);
        font-size: 0.6875rem;
        color: var(--text-3);
        letter-spacing: 0.01em;
        /* long addresses stay on one line, clear of the dots */
        max-width: calc(100% - 7rem);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .frame__view {
        position: relative;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .frame__mock {
        position: absolute;
        inset: 0;
    }

    .frame__shot {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        background: var(--surface-solid);
    }

    .frame__shot.is-broken {
        display: none;
    }
</style>
